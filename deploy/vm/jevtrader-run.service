[Unit]
Description=jevtrader paper trading session
Requires=jevtrader-prepare.service
After=jevtrader-prepare.service docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/run/jevtrader/secrets.env
# Wait (without a start timeout) for the operator's daily Kite login.
ExecStartPre=/usr/local/lib/jevtrader/wait-for-login.sh
# Then hold back until the final watchlist is written, but never past 09:13 IST.
ExecStartPre=/usr/local/lib/jevtrader/wait-for-watchlist.sh
ExecStart=/usr/local/lib/jevtrader/run.sh
ExecStop=-/usr/bin/docker stop --time 30 jevtrader
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
